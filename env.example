# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID del canal donde se publican los desafíos
CHANNEL_ID=

# Duración de la encuesta en horas (Discord solo acepta números enteros de horas, 1 a 768)
POLL_DURATION_HOURS=24

# Nota: la hora de publicación ya NO se configura aquí.
# La controla el cron de .github/workflows/daily.yml
